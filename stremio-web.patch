+// Wrapper that hosts the "Download to PC" button next to the stream row.
+.stream-wrapper {
+    position: relative;
+
+    .download-button {
+        position: absolute;
+        top: 50%;
+        // Sits right in front of the play icon, which is the last item of the row.
+        right: 4.4rem;
+        transform: translateY(-50%);
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        width: 2.4rem;
+        height: 2.4rem;
+        padding: 0.55rem;
+        border-radius: 50%;
+        background-color: var(--secondary-accent-color);
+        color: var(--primary-foreground-color);
+        z-index: 1;
+
+        &:hover,
+        &:focus {
+            background-color: var(--primary-accent-color);
+            outline-style: solid;
+        }
+    }
+
+    .download-icon {
+        width: 100%;
+        height: 100%;
+    }
+}
+
+// Keep the description clear of the absolutely positioned download button.
+.stream-wrapper.has-download {
+    .description-container {
+        padding-right: 3rem;
+    }
+}
